{
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "enabledPlugins": {
    "data@knowledge-work-plugins": true,
    "design@knowledge-work-plugins": true,
    "operations@knowledge-work-plugins": true,
    "productivity@knowledge-work-plugins": true,
    "product-management@knowledge-work-plugins": true,
    "engineering@knowledge-work-plugins": true,
    "enterprise-search@knowledge-work-plugins": true,
    "pdf-viewer@knowledge-work-plugins": true,
    "human-resources@knowledge-work-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mo_phien.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/chan_qcdata.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kiem_sau_sua.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
